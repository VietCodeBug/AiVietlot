SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-new-server-secret
# Optional: use the exact URI from Supabase Connect. URL-encode password characters.
DATABASE_URL=postgresql://postgres:encoded-password@your-host:5432/postgres?sslmode=require
# Prefer separate fields if the password contains @, #, [, or ].
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
